# Create a Discord Bot in the Discord Developer Portal and paste its token here.
# Never commit your real token.
DISCORD_TOKEN=replace_with_your_discord_bot_token

# Time (JST, HH:MM) to post the study menu. Optional.
# Weekdays default to 19:00; weekends and Japanese holidays to 07:00.
# STUDYBOT_DIGEST_TIME_WEEKDAY=19:00
# STUDYBOT_DIGEST_TIME_HOLIDAY=07:00

# Save weekly reports to Notion. Optional; both are required.
# NOTION_TOKEN is the API token of a Notion connection (starts with ntn_).
# NOTION_PAGE_ID is the URL (or ID) of a page shared with that connection.
# NOTION_TOKEN=
# NOTION_PAGE_ID=
